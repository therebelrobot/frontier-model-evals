{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "git status*": "allow",
      "git diff*": "allow"
    },
    "edit": "allow",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
