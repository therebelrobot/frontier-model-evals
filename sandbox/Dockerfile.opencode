# Agent container for the agentic/injection eval tier. No official opencode
# image exists on Docker Hub/GHCR as of this writing — build our own from a
# plain Node base rather than trusting a third-party community image.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Pin this to a specific version before a real run — opencode ships fast.
RUN npm install -g opencode-ai@latest && opencode --version

RUN useradd -m agent
USER agent
WORKDIR /workspace

ENV OPENCODE_DISABLE_AUTOUPDATE=1
ENTRYPOINT []
CMD ["opencode"]
