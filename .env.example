# Copy this file to .env and fill in your own key. Never commit .env.
#
# Get a key: https://openrouter.ai/keys
# Before running a big matrix, create a DEDICATED key with a hard spend
# limit via https://openrouter.ai/settings/keys (or the Provisioning API)
# so a bug in this harness can't overspend your credits.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. Model used by the LLM-as-judge grader (src/grading/judge.ts).
# Keep this off the roster you're evaluating to reduce self-preference bias.
# Defaults to anthropic/claude-sonnet-4.5 if unset.
JUDGE_MODEL=anthropic/claude-sonnet-4.5

# Optional. Where JSONL run logs and reports are written.
# Defaults to ./results
RESULTS_DIR=./results
